{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novacommerce.io/schemas/events/stock_updated_v1.json",
  "title": "stock_updated_v1",
  "type": "object",
  "properties": {
    "event": { "const": "stock_updated" },
    "version": { "const": 1 },
    "productId": { "type": "string", "format": "uuid" },
    "oldQuantity": { "type": "integer", "minimum": 0 },
    "newQuantity": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["event", "version", "productId", "oldQuantity", "newQuantity", "updatedAt"],
  "additionalProperties": false
}

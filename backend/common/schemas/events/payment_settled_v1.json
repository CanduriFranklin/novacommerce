{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novacommerce.io/schemas/events/payment_settled_v1.json",
  "title": "payment_settled_v1",
  "type": "object",
  "properties": {
    "event": { "const": "payment_settled" },
    "version": { "const": 1 },
    "paymentId": { "type": "string", "format": "uuid" },
    "orderId": { "type": "string", "format": "uuid" },
    "amount": { "type": "number", "minimum": 0 },
    "settledAt": { "type": "string", "format": "date-time" }
  },
  "required": ["event", "version", "paymentId", "orderId", "amount", "settledAt"],
  "additionalProperties": false
}
